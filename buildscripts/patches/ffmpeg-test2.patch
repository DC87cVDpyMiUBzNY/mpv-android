diff --git a/libavcodec/mediacodecdec.c b/libavcodec/mediacodecdec.c
index bc176d8..95ae3f5 100644
--- a/libavcodec/mediacodecdec.c
+++ b/libavcodec/mediacodecdec.c
@@ -32,6 +32,7 @@
 #include "libavutil/intreadwrite.h"
 #include "libavutil/pixfmt.h"
 #include "libavutil/internal.h"
+#include "libavutil/time.h"
 
 #include "avcodec.h"
 #include "codec_internal.h"
@@ -59,6 +60,8 @@ typedef struct MediaCodecH264DecContext {
     int use_ndk_codec;
     // Ref. MediaFormat KEY_OPERATING_RATE
     int operating_rate;
+
+    int64_t stall_since;
 } MediaCodecH264DecContext;
 
 static av_cold int mediacodec_decode_close(AVCodecContext *avctx)
@@ -502,11 +505,16 @@ static int mediacodec_receive_frame(AVCodecContext *avctx, AVFrame *frame)
 
     /* poll for new frame */
     ret = ff_mediacodec_dec_receive(avctx, s->ctx, frame, false);
-    if (ret != AVERROR(EAGAIN))
+    if (ret != AVERROR(EAGAIN)) {
+        s->stall_since = 0;
         return ret;
+    }
 
     /* feed decoder */
     while (1) {
+        if (!s->stall_since)
+            s->stall_since = av_gettime_relative();
+
         if (s->ctx->current_input_buffer < 0 && !s->ctx->draining) {
             /* poll for input space */
             index = ff_AMediaCodec_dequeueInputBuffer(s->ctx->codec, 0);
@@ -519,17 +527,38 @@ static int mediacodec_receive_frame(AVCodecContext *avctx, AVFrame *frame)
                  * return EAGAIN, which violate the design.
                  */
                 if (ff_AMediaCodec_infoTryAgainLater(s->ctx->codec, index) &&
-                    ret == AVERROR(EAGAIN))
+                    ret == AVERROR(EAGAIN)) {
+                    int64_t stalled_for = av_gettime_relative() - s->stall_since;
+                    if (stalled_for > 5000000 && !s->ctx->flushing) {
+                        av_log(avctx, AV_LOG_WARNING,
+                               "Decoder made no progress for %"PRId64"ms, "
+                               "flushing codec to recover\n",
+                               stalled_for / 1000);
+                        if (ff_mediacodec_dec_flush(avctx, s->ctx) < 0)
+                            return AVERROR_EXTERNAL;
+                        s->stall_since = 0;
+                        continue;
+                    }
+                    if (stalled_for > 100000) {
+                        av_log(avctx, AV_LOG_DEBUG,
+                               "No decoder progress in %dms, returning EAGAIN\n",
+                               (int)(100000 / 1000));
+                        return AVERROR(EAGAIN);
+                    }
                     continue;
+                }
+                s->stall_since = 0;
                 return ret;
             }
             s->ctx->current_input_buffer = index;
+            s->stall_since = 0;
         }
 
         /* try to flush any buffered packet data */
         if (s->buffered_pkt.size > 0) {
             ret = ff_mediacodec_dec_send(avctx, s->ctx, &s->buffered_pkt, false);
             if (ret >= 0) {
+                s->stall_since = 0;
                 s->buffered_pkt.size -= ret;
                 s->buffered_pkt.data += ret;
                 if (s->buffered_pkt.size <= 0) {
@@ -573,6 +602,8 @@ static void mediacodec_decode_flush(AVCodecContext *avctx)
 {
     MediaCodecH264DecContext *s = avctx->priv_data;
 
+    s->stall_since = 0;
+
     av_packet_unref(&s->buffered_pkt);
 
     ff_mediacodec_dec_flush(avctx, s->ctx);
